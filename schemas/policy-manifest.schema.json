{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/policy-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fragments"],
  "properties": {
    "version": {"const": 2},
    "fragments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/].*\\.ya?ml$"
      }
    }
  }
}
