{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/policy-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fragments"],
  "properties": {
    "version": {"const": 2},
    "fragments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing", "scheduling", "classification", "topology"],
      "properties": {
        "routing": {"$ref": "#/$defs/fragmentPath"},
        "scheduling": {"$ref": "#/$defs/fragmentPath"},
        "classification": {"$ref": "#/$defs/fragmentPath"},
        "topology": {"$ref": "#/$defs/fragmentPath"}
      }
    }
  },
  "$defs": {
    "fragmentPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*\\.ya?ml$"
    }
  }
}
