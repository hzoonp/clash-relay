{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/mihomo-output.json",
  "type": "object",
  "required": ["mixed-port", "mode", "proxy-providers", "proxy-groups", "rules"],
  "properties": {
    "mixed-port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "mode": {"type": "string"},
    "proxy-providers": {"type": "object"},
    "proxy-groups": {"type": "array", "minItems": 1},
    "rules": {"type": "array", "minItems": 1}
  }
}
