{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/mihomo-output.json",
  "type": "object",
  "required": ["mixed-port", "mode", "proxy-providers", "proxy-groups", "rules"],
  "properties": {
    "mixed-port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "listeners": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "listen", "port", "proxy"],
        "properties": {
          "name": {"const": "download-in"},
          "type": {"const": "mixed"},
          "listen": {"const": "127.0.0.1"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "proxy": {"const": "下载流量"}
        }
      }
    },
    "mode": {"type": "string"},
    "proxy-providers": {"type": "object"},
    "rule-providers": {"type": "object"},
    "proxy-groups": {"type": "array", "minItems": 1},
    "rules": {"type": "array", "minItems": 1}
  }
}
