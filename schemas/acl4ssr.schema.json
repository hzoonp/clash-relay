{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/acl4ssr.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "ref", "license", "max_source_bytes", "sources", "inline_rules"],
  "properties": {
    "version": {"const": 1},
    "repository": {"const": "ACL4SSR/ACL4SSR"},
    "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"const": "CC-BY-SA-4.0"},
    "max_source_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "members"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^,\\r\\n]+$"
          },
          "module": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "source_use": {"$ref": "#/$defs/sourceUse"},
          "excluded_sources": {"$ref": "#/$defs/sourceIdList"},
          "hidden": {"type": "boolean"},
          "type": {"enum": ["select", "url-test", "fallback"]},
          "provider_pool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "filter": {"type": "string", "minLength": 1, "maxLength": 512},
          "url": {"type": "string", "pattern": "^https?://"},
          "interval": {"type": "integer", "minimum": 1, "maximum": 86400},
          "tolerance": {"type": "integer", "minimum": 0, "maximum": 10000},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 120000},
          "lazy": {"type": "boolean"},
          "expected_status": {"type": ["string", "integer"]},
          "route": {"$ref": "#/$defs/routeMetadata"},
          "members": {
            "type": "array",
            "items": {"$ref": "#/$defs/groupMember"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "url-test"}}, "required": ["type"]},
            "then": {"required": ["provider_pool", "url", "interval", "tolerance"]}
          },
          {
            "if": {"properties": {"type": {"const": "fallback"}}, "required": ["type"]},
            "then": {"required": ["url", "interval"]}
          },
          {
            "if": {"properties": {"members": {"maxItems": 0}}},
            "then": {"required": ["provider_pool"]}
          }
        ]
      }
    },
    "final_target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^,\\r\\n]+$"
    },
    "final_source_use": {"$ref": "#/$defs/sourceUse"},
    "final_scenario": {"$ref": "#/$defs/scenario"},
    "final_excluded_sources": {"$ref": "#/$defs/sourceIdList"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "target", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "mihomo_compatibility_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "target": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^,\\r\\n]+$"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
          "module": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "source_use": {"$ref": "#/$defs/sourceUse"},
          "scenario": {"$ref": "#/$defs/scenario"},
          "service": {"$ref": "#/$defs/service"},
          "excluded_sources": {"$ref": "#/$defs/sourceIdList"}
        }
      }
    },
    "inline_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "value", "target", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {
            "enum": [
              "DOMAIN", "DOMAIN-SUFFIX", "DOMAIN-KEYWORD", "DOMAIN-REGEX",
              "IP-CIDR", "IP-CIDR6", "SRC-IP-CIDR", "DST-PORT", "SRC-PORT",
              "PROCESS-NAME", "PROCESS-PATH", "NETWORK", "GEOIP"
            ]
          },
          "value": {"type": ["string", "integer"]},
          "target": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^,\\r\\n]+$"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
          "module": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "source_use": {"$ref": "#/$defs/sourceUse"},
          "scenario": {"$ref": "#/$defs/scenario"},
          "service": {"$ref": "#/$defs/service"},
          "options": {"type": "array", "uniqueItems": true, "items": {"enum": ["no-resolve"]}}
        }
      }
    }
  },
  "$defs": {
    "sourceUse": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "scenario": {
      "enum": ["direct", "general", "browsing", "media", "download", "ai", "final"]
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "sourceIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
    },
    "routeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario"],
      "properties": {
        "scenario": {"$ref": "#/$defs/scenario"},
        "service": {"$ref": "#/$defs/service"},
        "deterministic": {"type": "boolean"},
        "member": {"$ref": "#/$defs/groupMember"},
        "profile": {"enum": ["direct", "general", "browsing", "media", "download", "ai"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"deterministic": {"const": true}},
            "required": ["deterministic"]
          },
          "then": {"required": ["member"]}
        }
      ]
    },
    "groupMember": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["builtin"],
          "properties": {
            "builtin": {"enum": ["DIRECT", "REJECT", "PASS", "COMPATIBLE"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["group"],
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^,\\r\\n]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["auto_pool"],
          "properties": {
            "auto_pool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      ]
    }
  }
}
