{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clash-relay.invalid/schema/config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "modules", "generation", "publishing"],
  "properties": {
    "version": {"const": 2},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mixed_port", "allow_lan", "bind_address", "mode", "log_level", "ipv6", "unified_delay", "tcp_concurrent", "profile", "dns"],
      "properties": {
        "mixed_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "allow_lan": {"type": "boolean"},
        "bind_address": {"type": "string", "minLength": 1},
        "mode": {"enum": ["rule", "global", "direct"]},
        "log_level": {"enum": ["silent", "error", "warning", "info", "debug"]},
        "ipv6": {"type": "boolean"},
        "unified_delay": {"type": "boolean"},
        "tcp_concurrent": {"type": "boolean"},
        "network_profile": {"enum": ["default", "cn_three_net"]},
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_selected", "store_fake_ip"],
          "properties": {
            "store_selected": {"type": "boolean"},
            "store_fake_ip": {"type": "boolean"}
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["client", "managed"]},
            "enabled": {"type": "boolean"},
            "ipv6": {"type": "boolean"},
            "enhanced_mode": {"enum": ["fake-ip", "redir-host", "normal"]},
            "listen": {"type": "string", "minLength": 1},
            "respect_rules": {"type": "boolean"},
            "default_nameservers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "nameservers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "proxy_server_nameservers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "direct_nameservers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "nameserver_policy_overrides": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?!.*[*?])(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "direct_nameserver_follow_policy": {"type": "boolean"},
            "routing_policy": {"enum": ["none", "acl4ssr"]},
            "fallback_nameservers": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "fake_ip_range": {"type": "string", "minLength": 1},
            "fake_ip_filter_mode": {"enum": ["blacklist", "whitelist", "rule"]},
            "fake_ip_filter": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [
            {
              "if": {"required": ["mode"], "properties": {"mode": {"const": "client"}}},
              "then": {},
              "else": {"required": ["enabled", "enhanced_mode", "listen", "nameservers", "fallback_nameservers"]}
            },
            {
              "if": {"required": ["respect_rules"], "properties": {"respect_rules": {"const": true}}},
              "then": {"required": ["proxy_server_nameservers"]}
            },
            {
              "if": {"required": ["routing_policy"], "properties": {"routing_policy": {"const": "acl4ssr"}}},
              "then": {"required": ["direct_nameservers", "direct_nameserver_follow_policy"]}
            }
          ]
        },
        "tun": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["client", "managed"]},
            "enabled": {"type": "boolean"},
            "stack": {"enum": ["system", "gvisor", "mixed", "mips"]},
            "dns_hijack": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "auto_route": {"type": "boolean"},
            "auto_detect_interface": {"type": "boolean"},
            "strict_route": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {"required": ["mode"], "properties": {"mode": {"const": "client"}}},
              "then": {},
              "else": {"required": ["enabled", "stack", "dns_hijack", "auto_route", "auto_detect_interface", "strict_route"]}
            }
          ]
        },
        "sniffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "force_dns_mapping", "parse_pure_ip", "sniff"],
          "properties": {
            "enabled": {"type": "boolean"},
            "force_dns_mapping": {"type": "boolean"},
            "parse_pure_ip": {"type": "boolean"},
            "sniff": {
              "type": "object",
              "additionalProperties": false,
              "required": ["http", "tls", "quic"],
              "properties": {
                "http": {"$ref": "#/$defs/httpSniff"},
                "tls": {"$ref": "#/$defs/sniffPorts"},
                "quic": {"$ref": "#/$defs/sniffPorts"}
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "boolean"}
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_successful_subscriptions", "minimum_usable_nodes", "fetch_timeout_seconds", "max_subscription_bytes", "invalid_proxy_policy", "duplicate_policy", "allow_http_subscription_urls", "allow_file_subscription_urls", "reject_private_proxy_hosts", "fail_on_required_subscription_error", "node_name_prefix", "generated_header"],
      "properties": {
        "minimum_successful_subscriptions": {"type": "integer", "minimum": 1},
        "minimum_usable_nodes": {"type": "integer", "minimum": 1},
        "fetch_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "max_subscription_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864},
        "invalid_proxy_policy": {"enum": ["error", "skip"]},
        "duplicate_policy": {"enum": ["keep_first", "error"]},
        "allow_http_subscription_urls": {"type": "boolean"},
        "allow_file_subscription_urls": {"type": "boolean"},
        "reject_private_proxy_hosts": {"type": "boolean"},
        "fail_on_required_subscription_error": {"type": "boolean"},
        "node_name_prefix": {"enum": ["source_id", "none"]},
        "generated_header": {"type": "boolean"}
      }
    },
    "rule_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acl4ssr"],
      "properties": {
        "acl4ssr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "manifest"],
          "properties": {
            "enabled": {"type": "boolean"},
            "manifest": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"}
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "github_release", "gist", "cloudflare_kv"],
      "properties": {
        "artifact": {"type": "boolean"},
        "github_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "allow_sensitive_public_release"],
          "properties": {
            "enabled": {"type": "boolean"},
            "allow_sensitive_public_release": {"type": "boolean"}
          }
        },
        "gist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "allow_sensitive_unlisted_gist"],
          "properties": {
            "enabled": {"type": "boolean"},
            "allow_sensitive_unlisted_gist": {"type": "boolean"}
          }
        },
        "cloudflare_kv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "key"],
          "properties": {
            "enabled": {"type": "boolean"},
            "key": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s]+$"}
          }
        }
      }
    }
  },
  "$defs": {
    "port": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 65535},
        {"type": "string", "pattern": "^[1-9][0-9]{0,4}-[1-9][0-9]{0,4}$"}
      ]
    },
    "sniffPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ports"],
      "properties": {"ports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/port"}}}
    },
    "httpSniff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ports", "override_destination"],
      "properties": {
        "ports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/port"}},
        "override_destination": {"type": "boolean"}
      }
    }
  }
}
